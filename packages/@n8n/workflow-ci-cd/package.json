{
  "name": "@n8n/workflow-ci-cd",
  "version": "1.0.0",
  "description": "CI/CD集成插件，将工作流性能分析和优化流程无缝集成到现有CI/CD管道中，实现工作流部署前的自动性能检查和优化",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./github-action": {
      "import": "./dist/github-action/index.js",
      "types": "./dist/github-action/index.d.ts"
    },
    "./gitlab-ci": {
      "import": "./dist/gitlab-ci/index.js",
      "types": "./dist/gitlab-ci/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "n8n-workflow": "workspace:*",
    "@n8n/errors": "workspace:*",
    "@n8n/utils": "workspace:*",
    "@n8n/workflow-benchmarker": "workspace:*",
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "commander": "^12.1.0",
    "glob": "^11.0.3",
    "lodash-es": "^4.17.21",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}