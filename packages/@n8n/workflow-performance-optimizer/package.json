    "@n8n/errors": "workspace:*",
    "@n8n/utils": "workspace:*",
    "lodash-es": "^4.17.21",
    "uuid": "^10.0.0",
    "chalk": "^4.1.2",
    "systeminformation": "^5.21.23"
  },
  "devDependencies": {
    "typescript": "~5.6.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "@types/node": "^20.11.30",
    "@types/lodash-es": "^4.17.12",
    "@types/uuid": "^10.0.0",
    "@types/chalk": "^2.2.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "prettier": "^3.2.5"
