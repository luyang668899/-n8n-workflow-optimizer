{
  "name": "@n8n/workflow-dependency-analyzer",
  "version": "1.0.0",
  "description": "n8n workflow dependency analyzer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "n8n",
    "workflow",
    "dependency",
    "analyzer"
  ],
  "author": "n8n",
  "license": "MIT",
  "dependencies": {
    "graphviz": "^0.0.9",
    "d3": "^7.9.0",
    "n8n-workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/d3": "^7.4.3",
    "@types/graphviz": "^0.0.38",
    "typescript": "^5.4.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "prettier": "^3.2.5"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
